# Copia este archivo como .env y rellena los valores
# NUNCA subas el .env real a GitHub

# Cadena de conexión de MongoDB Atlas (gratuito en https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/adios

# Secreto largo y aleatorio para firmar los JWT (genera uno en: https://randomkeygen.com)
JWT_SECRET=pon_aqui_un_secreto_muy_largo_y_aleatorio_123456

# URL de tu GitHub Pages (sin barra final). Si tienes varias, sepáralas con coma.
# Ejemplo: https://ianba.github.io,https://ianba.github.io/adios
FRONTEND_URL=https://ianba.github.io

# Contraseña del panel de administración (SOLO TÚ la sabes)
ADMIN_PASSWORD=pon_aqui_una_contrasena_muy_segura_para_el_admin

# Puerto (Render lo asigna automáticamente, no lo cambies)
PORT=3000
